-  if (!isChampion) return 20;
-  if (ctx.level >= 15) return 18;
-  if (ctx.level >= 3) return 19;
-  return 20;
-}
-
-function titleCase(value: string): string {
-  return value ? value.charAt(0).toUpperCase() + value.slice(1).toLowerCase() : value;
-}
