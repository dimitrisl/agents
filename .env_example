# ==============================================================================
# 🩸 Phyrexian Forge - Environment Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Google Gemini API Key (Required for AI Hero Forge & Strategic Playstyle Guides)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret Key (Auto-generated by setup.sh / setup.ps1)
JWT_SECRET_KEY=replace_with_a_secure_random_hex_string_in_production

# MongoDB Connection String & Database Name
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=phyrexian_forge

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:4200

# Debug mode (Set to False for production; enables demo bypass when True)
DEBUG_MODE=False
